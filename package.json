{
  "name": "astro-buffer",
  "version": "0.1.0",
  "description": "Share newly published Astro articles through Buffer.",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "test": "node --test test/*.test.mjs",
    "format:check": "prettier --check src test",
    "prepare": "npm run build"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "peerDependencies": {
    "astro": ">=6.0.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "astro": "^7.4.5",
    "prettier": "^3.9.10",
    "typescript": "^6.0.3"
  }
}
