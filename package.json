{
  "name": "astro-buffer",
  "version": "0.1.1",
  "description": "Share newly published Astro articles through Buffer.",
  "license": "MIT",
  "homepage": "https://github.com/HiroAgustin/astro-buffer#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/HiroAgustin/astro-buffer.git"
  },
  "keywords": [
    "astro-integration",
    "withastro",
    "buffer",
    "social-media"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "test": "npm run build && node --test test/*.test.mjs",
    "format:check": "prettier --check src test",
    "prepare": "npm run build"
  },
  "engines": {
    "node": ">=24"
  },
  "peerDependencies": {
    "astro": "^7.0.0"
  },
  "dependencies": {
    "yaml": "^2.8.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "astro": "^7.4.5",
    "prettier": "^3.9.10",
    "typescript": "^6.0.3"
  }
}
